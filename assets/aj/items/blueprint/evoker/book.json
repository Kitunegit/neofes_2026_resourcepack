		"cases": [
			{
				"when": "AJ_INTERNAL_EMPTY",
				"model": {
					"type": "minecraft:empty"
				}
			},
			{
				"when": "spawn1",
				"model": {
					"type": "minecraft:model",
					"model": "aj:blueprint/evoker/spawn1/book",
