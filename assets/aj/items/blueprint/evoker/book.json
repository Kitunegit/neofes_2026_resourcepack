						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			},
			{
				"when": "spawn3",
				"model": {
					"type": "minecraft:model",
					"model": "aj:blueprint/evoker/spawn3/book",
					"tints": [
						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			},
			{
				"when": "rod",
				"model": {
					"type": "minecraft:model",
					"model": "aj:blueprint/evoker/rod/book",
					"tints": [
						{"type": "minecraft:dye", "default": [1, 1, 1]}
					]
				}
			},
			{
				"when": "form_change",
				"model": {
					"type": "minecraft:model",
					"model": "aj:blueprint/evoker/form_change/book",
					"tints": [
						{"type": "minecraft:dye", "default": [1, 1, 1]}
